# Copy to .env and replace both passwords; never commit the filled file.
PATCHPROOF_API_KEY=replace-with-long-random-token
PATCHPROOF_DB_PASSWORD=replace-with-long-random-password
# Portable local SQLite default. For Docker PostgreSQL, override with
# postgresql+psycopg://patchproof:<password>@127.0.0.1:5432/patchproof
PATCHPROOF_DATABASE_URL=sqlite:///./patchproof.db
PATCHPROOF_DATA=./.patchproof-data
PATCHPROOF_OLLAMA_URL=http://127.0.0.1:11434
PATCHPROOF_PATCH_MODEL=qwen2.5-coder:7b
PATCHPROOF_EMBED_MODEL=nomic-embed-text
